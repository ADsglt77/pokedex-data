# Les clients de l'API et leur token (`src/auth.ts`) : nom:token, séparés par des virgules.
# Un token : `openssl rand -hex 32` (32 caractères au moins en production). Le site garde le sien
# dans son propre .env (DATA_API_TOKEN) ; chaque client de https://api.pokecodex.fr (un script, une
# autre app) a le sien, par exemple : API_TOKENS=pokedex:<token du site>,moi:<un autre token>
API_TOKENS=pokedex:
