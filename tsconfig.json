{
  // Le Worker (`worker/`, ses tâches d'ingestion et ses tests) et `src/` (le contrat, que le site
  // vérifie contre sa copie ; la configuration et les règles pures du Worker) : les types de
  // Cloudflare (et de `cloudflare:test`). `scripts/ingest.ts`, que lance Bun, n'y est pas.
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "worker"]
}
