// Le Worker des données (pokedex-data), lu par Wrangler (`bun run dev`) et par ses tests
// (`vitest.config.ts`). Le site le joint par une liaison de service (son entrée `SiteEntrypoint`) ;
// ses autres clients par `https://api.pokecodex.fr`, avec leur token.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedex-data",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // Le calcul d'une demande ou d'une étape des tâches, au plus : le guide des prix, lu en flux, et
  // ses dizaines de milliers de cartes en demandent plus que les 30 s par défaut. Et les requêtes
  // d'une exécution (sources, R2, D1), au plus : un Workflow enchaîne ses étapes dans une même
  // exécution, et la copie des images ou la reprise de l'historique en font des centaines de
  // milliers ; les 10 000 par défaut l'arrêtaient en route. 10 millions : le maximum permis.
  "limits": { "cpu_ms": 300000, "subrequests": 10000000 },
  // Les données de référence (`worker/schema.ts`), leurs migrations écrites par Drizzle
  // (`bun run db:generate`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedex-data",
      "database_id": "079a5e09-90e2-4c1c-9712-ec498fa026ac",
      // La base locale (`.wrangler/`) reste celle rangée sous le nom de la liaison : avec
      // l'identifiant de la base en ligne, Wrangler en ouvrirait une neuve, vide.
      "preview_database_id": "DB",
      "migrations_dir": "worker/migrations",
    },
    // Le catalogue de TCGdex, tel que le copie l'importateur `pokecodex-importer` (dépôt
    // `../pokecodex-api`) : lu seulement, par la tâche `catalog`. Son schéma est celui de
    // l'importateur (pas de `migrations_dir` : ses migrations sont les siennes).
    {
      "binding": "CARDS",
      "database_name": "pokecodex-cards",
      "database_id": "7a534301-31ff-4d62-b42c-f5d1e3800e51",
      "preview_database_id": "CARDS",
    },
  ],
  // `FILES` : les images des Pokémon (`images/species/…`) et les réponses volumineuses calculées
  // par les tâches (`snapshots/…`). `IMPORTS`, le même bucket en ligne : les images des cartes et
  // les logos des séries que copie l'importateur (`cards/…`), lus seulement (`worker/images.ts`) ;
  // une liaison à part, pour qu'en développement elle puisse viser les images de l'importateur
  // sans que les écritures des tâches (`FILES`, local) y aillent jamais.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "pokedex-data" },
    { "binding": "IMPORTS", "bucket_name": "pokedex-data" },
  ],
  // Les limites de l'entrée d'Internet (`worker/limits.ts`) : toutes les demandes, par réseau ; les
  // routes coûteuses, et les lignes de la liste de souhaits, par client.
  // Leurs `namespace_id` sont partagés par tout le compte : ceux du site sont 2001 à 2006.
  "ratelimits": [
    { "name": "ANY_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 10 } },
    { "name": "HEAVY_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 10 } },
    { "name": "WANTS_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 10 } },
  ],
  // Les tâches d'ingestion (`worker/ingest/workflow.ts`), et le Cron qui lance chaque heure celles
  // à rythme qui sont dues (les prix, le catalogue, les espèces : `worker/index.ts`).
  "workflows": [{ "name": "ingest", "binding": "INGEST", "class_name": "Ingest" }],
  "triggers": { "crons": ["0 * * * *"] },
  // Les clients et leur token (`API_TOKENS`) sont un secret du Worker, jamais dans ce fichier.
  // En ligne à son adresse seulement (le domaine sur Cloudflare : `docs/deploiement.md` du site) :
  // ni l'adresse `workers.dev` ni celle des aperçus.
  "routes": [{ "pattern": "api.pokecodex.fr", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
