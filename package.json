{
  "name": "pokedex-data",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run db:migrate && wrangler dev --test-scheduled --infer-origin-from-routes=false",
    "ingest": "bun scripts/ingest.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "lint": "eslint . && knip",
    "test": "vitest run",
    "format": "prettier --write src/ worker/ scripts/",
    "format:check": "prettier --check src/ worker/ scripts/",
    "ci": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5",
    "wrangler": "^4.154.0"
  }
}
